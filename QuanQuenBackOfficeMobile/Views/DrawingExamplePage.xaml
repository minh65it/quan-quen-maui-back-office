<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="QuanQuenBackOfficeMobile.Views.DrawingExamplePage"
             x:DataType="vm:DrawingExampleViewModel"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="32">

            <!-- Chữ ký Hợp Đồng -->
            <Frame CornerRadius="16" Padding="16" BackgroundColor="#FFF8E1" HasShadow="True">
                <VerticalStackLayout Spacing="12">

                    <!-- Header + Clear -->
                    <Grid ColumnDefinitions="*,Auto,*" Padding="0,0,0,4">
                        <Label Text="Chữ Ký Hợp Đồng"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#F58220"
                               VerticalOptions="Center" />

                    </Grid>

                    <Border Stroke="#E0E0E0" StrokeThickness="1" Background="#F9F9F9">
                        <toolkit:DrawingView
                            x:Name="ContractDrawingView"
                            HeightRequest="180"
                            Lines="{Binding ContractLines, Mode=TwoWay}"
                            IsMultiLineModeEnabled="True"
                            BackgroundColor="Transparent"
                            VerticalOptions="Fill"
                            HorizontalOptions="FillAndExpand"
                            StyleClass="signatureBox" />
                    </Border>
                    <Button Grid.Column="1"
                             Command="{Binding ClearContractCommand}"
                             Text="Xóa chữ ký hợp đồng"
                             CornerRadius="18"
                             BorderColor="#80000000"
                             BorderWidth="1"
                             BackgroundColor="White"
                             TextColor="Black"
                             FontSize="14"
                             FontAttributes="Bold"
                             HeightRequest="36"
                             Padding="14,6" />

                </VerticalStackLayout>
            </Frame>

            <!-- Chữ ký Phụ Lục -->
            <Frame CornerRadius="16" Padding="16" BackgroundColor="#E3F2FD" HasShadow="True">
                <VerticalStackLayout Spacing="12">

                    <!-- Header + Clear -->
                    <Grid ColumnDefinitions="*,Auto,*" Padding="0,0,0,4">
                        <Label Text="Chữ Ký Phụ Lục"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1976D2"
                               VerticalOptions="Center" />

                    </Grid>

                    <Border Stroke="#E0E0E0" StrokeThickness="1" Background="#F9F9F9">
                        <toolkit:DrawingView
                            x:Name="AppendixDrawingView"
                            HeightRequest="180"
                            Lines="{Binding AppendixLines, Mode=TwoWay}"
                            IsMultiLineModeEnabled="True"
                            BackgroundColor="Transparent"
                            VerticalOptions="Fill"
                            HorizontalOptions="FillAndExpand"
                            StyleClass="signatureBox" />
                    </Border>
                    <Button Grid.Column="1"
                            Command="{Binding ClearAppendixCommand}"
                            Text="Xóa chữ ký phụ lục"
                            CornerRadius="18"
                            BorderColor="#80000000"
                            BorderWidth="1"
                            BackgroundColor="White"
                            TextColor="Black"
                            FontSize="14"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            Padding="14,6" />

                </VerticalStackLayout>
            </Frame>

            <!-- Nút Lưu -->    
            <Button
                Clicked="SaveClicked"
                Text="💾 Lưu"
                CornerRadius="24"
                BorderColor="Transparent"
                BorderWidth="1"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                Margin="0,16,0,0"
                HeightRequest="48"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="Center">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FEBC18" Offset="0.0" />
                        <GradientStop Color="#F58220" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
