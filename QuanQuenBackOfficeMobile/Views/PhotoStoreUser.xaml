<ContentPage
    x:Class="QuanQuenBackOfficeMobile.Views.PhotoStoreUser"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
    xmlns:models="clr-namespace:QuanQuenBackOfficeMobile.Models"
    xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
    BackgroundColor="#F5F5F5"
    x:DataType="viewmodels:PhotoStoreUserViewModel"
    x:Name="RootPage"
    Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="10">
            <!-- Logo và tên ứng dụng -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="logo_qq_new.png" HeightRequest="80" WidthRequest="80" />
            </VerticalStackLayout>

            <!-- Tiêu đề -->
            <Label Text="Thêm hình ảnh nhà hàng"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Label Text="Ảnh nhà hàng (tối đa 6 ảnh)"
                   FontSize="14"
                   TextColor="Black" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Chụp ảnh nhà hàng"
                        Command="{Binding CaptureImageCommand}"
                        IsEnabled="{Binding CanAddMoreImages}"
                        HeightRequest="44"
                        FontSize="16"
                        BackgroundColor="#F5F5F5"
                        TextColor="{Binding ButtonTextColor}"
                        BorderColor="#F58220"
                        CornerRadius="12"/>
                <Button Text="Chọn ảnh nhà hàng"
                        Command="{Binding PickImageCommand}"
                        IsEnabled="{Binding CanAddMoreImages}"
                        HeightRequest="44"
                        FontSize="16"
                        BackgroundColor="#F5F5F5"
                        TextColor="{Binding ButtonTextColor}"
                        BorderColor="#F58220"
                        CornerRadius="12"/>
            </HorizontalStackLayout>
            <CollectionView x:Name="PhotoCollectionView"
                ItemsSource="{Binding StoreImages}"
                HeightRequest="200"
                Margin="0,5,0,0"
                >
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MyImageModel">
                        <Border HeightRequest="80" WidthRequest="80"
                    Stroke="#E0E0E0" StrokeThickness="1"
                    Background="White"
                    Margin="2" Padding="0"
                    HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Image Source="{Binding Images}" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" Margin="0"/>
                                <Border Padding="0" HeightRequest="20" WidthRequest="20" Background="White" Stroke="White" StrokeThickness="1"
                            HorizontalOptions="End" VerticalOptions="Start" Margin="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Image Source="multiply.png"
                               WidthRequest="16" HeightRequest="16"
                               HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                    Command="{Binding BindingContext.RemoveImageCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                    CommandParameter="{Binding Images}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ContentView WidthRequest="15"/>
                </CollectionView.Footer>
            </CollectionView>

            <!-- Nút Lưu -->
            <Button Text="Lưu"
                    Command="{Binding SavePhotoCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                    HeightRequest="50"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    CornerRadius="25"
                    BackgroundColor="#F58220"
                    Margin="0,20,0,0"/>

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
