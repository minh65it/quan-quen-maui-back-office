<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels.Stores"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.AgreementPage"
             x:DataType="viewmodels:AgreementPageViewModel"
             Title="Hợp Đồng Hợp Tác">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- PDF hiển thị -->
        <WebView Grid.Row="0"
                 x:Name="AgreementWebView"
                 Source="{Binding PdfSource}"
                 IsVisible="{Binding IsPdfLoaded}" />

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="0"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Color="#2196F3" />

        <!-- Error message -->
        <VerticalStackLayout Grid.Row="0" 
                            IsVisible="{Binding HasError}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="10">
            <Label Text="❌" 
                   FontSize="48" 
                   HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}" 
                   FontSize="16" 
                   TextColor="Red"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Text="Thử lại" 
                    Command="{Binding RetryCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontSize="14"
                    HeightRequest="40"
                    WidthRequest="120"
                    CornerRadius="20"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Footer chỉ chứa Nút Tiếp tục -->
        <Button Grid.Row="1"
                Text="📸 Tiếp Tục - Thêm Ảnh Cửa Hàng"
                IsVisible="{Binding IsPdfLoaded}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="48"
                CornerRadius="24"
                HorizontalOptions="FillAndExpand"
                Margin="15"
                Clicked="OnContinueClicked"/>

    </Grid>
</ContentPage>
