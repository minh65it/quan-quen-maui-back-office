<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels.Stores"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.AgreementPage"
             x:DataType="viewmodels:AgreementPageViewModel"
             Title="Hợp Đồng Hợp Tác">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- PDF hiển thị -->
        <WebView Grid.Row="0"
                 x:Name="AgreementWebView"
                 Source="{Binding PdfSource}"
                 IsVisible="{Binding IsPdfLoaded}" />

        <!-- Loading / Error overlay -->
        <AbsoluteLayout Grid.Row="0">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="#2196F3" />

            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 AbsoluteLayout.LayoutFlags="All"
                                 AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="10">
                <Label Text="❌" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}" 
                       FontSize="16" 
                       TextColor="Red"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Thử lại" 
                        Command="{Binding RetryCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="14"
                        HeightRequest="40"
                        WidthRequest="120"
                        CornerRadius="20"
                        HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </AbsoluteLayout>

        <!-- Footer chứa Nút và QR -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="15"
              BackgroundColor="WhiteSmoke">

            <!-- Nút Tiếp tục -->
            <Button Grid.Column="0"
                    Text="📸 Tiếp Tục - Thêm Ảnh Cửa Hàng"
                    IsVisible="{Binding IsPdfLoaded}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="24"
                    HorizontalOptions="FillAndExpand"
                    Clicked="OnContinueClicked"/>

            <!-- QR Code Card -->
            <Frame Grid.Column="1"
                   IsVisible="{Binding IsPdfLoaded}"
                   Padding="10"
                   Margin="10,0,0,0"
                   WidthRequest="160"
                   HeightRequest="160"
                   HasShadow="True"
                   CornerRadius="12"
                   BackgroundColor="White">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="🏪 QR Code"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333"
                           HorizontalOptions="Center"/>

                    <ActivityIndicator IsRunning="{Binding IsQrCodeLoading}"
                                       IsVisible="{Binding IsQrCodeLoading}"
                                       Color="#2196F3"/>

                                         <Image Source="{Binding QrCodeImage}"
                            IsVisible="{Binding IsQrCodeVisible}"
                            HeightRequest="130"
                            WidthRequest="130"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"/>

                     <Label Text="{Binding QrCodeErrorMessage}"
                            IsVisible="{Binding QrCodeErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                            FontSize="10"
                            TextColor="Red"
                            HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
