<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
    xmlns:models="clr-namespace:QuanQuenBackOfficeMobile.Models"
    xmlns:Controls="clr-namespace:QuanQuenBackOfficeMobile.Controls"
    xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
    x:Class="QuanQuenBackOfficeMobile.Views.StorePage"
    x:DataType="vm:StorePageViewModel">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullOrEmptyToNAConverter x:Key="NullOrEmptyToNAConverter" />
            <converters:AvatarUrlConverter x:Key="AvatarUrlConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="8" RowSpacing="8">
        <!-- Logo Section -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" Margin="0,10,0,20">
            <Image Source="logo_qq_new.png" HeightRequest="80" WidthRequest="80" />
        </VerticalStackLayout>

        <!-- Header -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label Text="Danh sách nhà hàng" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Grid.Column="0"/>
            <Button Text="➕ Tạo mới"
                    Command="{Binding CreateStoreCommand}"
                    Grid.Column="1"
                    FontSize="12"
                    BackgroundColor="{StaticResource Orange70Color}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="35"
                    CornerRadius="8"/>
        </Grid>

        <!-- Search Bar -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,0">
            <Border Stroke="{AppThemeBinding Light={StaticResource Orange70Color}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="0"
                    Margin="0,0,5,0"
                    HeightRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Controls:NoUnderlineEntry Placeholder="Tìm kiếm cửa hàng..." 
                       Text="{Binding SearchText}"
                       FontSize="14"
                       Margin="10,0"
                       VerticalOptions="Center"
                       HeightRequest="40"
                       ReturnCommand="{Binding SearchCommand}"
                       ReturnType="Search"/>
            </Border>
            <Button Grid.Column="1"
                    Text="🔍" 
                    Command="{Binding SearchCommand}"
                    FontSize="18"
                    Padding="0"
                    HeightRequest="40"
                    WidthRequest="40"
                    CornerRadius="8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Orange70Color}, Dark={StaticResource Primary}}"
                    TextColor="White"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>
        </Grid>

        <!-- Store List -->
        <Grid Grid.Row="3">
            <CollectionView
                ItemsSource="{Binding Stores}"
                RemainingItemsThreshold="5"
                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached"
                Margin="0,10,0,0"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="Không có cửa hàng nào"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StoreModel">
                        <StackLayout Margin="0,0,0,10">
                            <Frame Padding="0" CornerRadius="18" HasShadow="True" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" BorderColor="{AppThemeBinding Light={StaticResource Orange70Color}, Dark={StaticResource OrangeColor}}">
                                <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto" Padding="12">
                                    <!-- Avatar -->
                                    <Frame Grid.Column="0" Padding="0" HeightRequest="64" WidthRequest="64" CornerRadius="24" HasShadow="False" BackgroundColor="#FFF3E0" VerticalOptions="Center">
                                        <Image Source="{Binding Avatar, Converter={StaticResource AvatarUrlConverter}}" HeightRequest="64" WidthRequest="64" Aspect="AspectFill"/>
                                    </Frame>
                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                                        <Label Text="{Binding StoreName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Address}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding StoreType, Converter={StaticResource NullOrEmptyToNAConverter}}" FontSize="12" TextColor="#009688"/>
                                        <Label Text="{Binding OpeningTime, StringFormat='Giờ mở cửa: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource OrangeColor}, Dark={StaticResource OrangeColor}}"/>
                                    </VerticalStackLayout>
                                    <!-- Status + Action -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                                        <Border BackgroundColor="{Binding IsOpen, Converter={x:Static converters:BoolToColorConverter.Instance}}"
                                                Padding="6,2" Margin="0,0,0,6" >
                                            <Label Text="{Binding IsOpen, Converter={x:Static converters:BoolToStatusConverter.Instance}}"
                                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" FontAttributes="Bold"/>
                                        </Border>
                                        <Button Text="Chi tiết"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StorePageViewModel}}, Path=ViewDetailCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="12"
                                                Padding="8,2"
                                                BackgroundColor="{StaticResource Orange70Color}"
                                                TextColor="White"
                                                CornerRadius="8"
                                                HeightRequest="28"
                                                WidthRequest="70"
                                                HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Grid IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="True" 
                                         HorizontalOptions="Center" 
                                         VerticalOptions="Center" 
                                         Margin="0,10"/>
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>

            <!-- Loading Overlay -->
            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="{AppThemeBinding Light={StaticResource Black50Color}, Dark={StaticResource Black20Color}}">
                <ActivityIndicator IsRunning="True"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="White"/>
            </Grid>

            <!-- AI Chatbot Floating Button - Simple Version -->
            <Button x:Name="ChatbotButton" Text="💬" WidthRequest="56" HeightRequest="56" CornerRadius="28"
                    BackgroundColor="{StaticResource Orange70Color}" TextColor="White"
                    Command="{Binding ToggleChatbotCommand}"
                    HorizontalOptions="End" VerticalOptions="End" Margin="16">
            </Button>

            <!-- AI Chatbot Overlay -->
            <Grid IsVisible="{Binding IsChatbotVisible}" BackgroundColor="#80000000">
                <Frame CornerRadius="16" Padding="0" HasShadow="True" BackgroundColor="White"
                       HorizontalOptions="End" VerticalOptions="End" Margin="16" WidthRequest="320" HeightRequest="400">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" Padding="12" BackgroundColor="{StaticResource Orange70Color}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="AI Chatbot" FontAttributes="Bold" FontSize="16" TextColor="White" Grid.Column="0"/>
                                <Button Text="✕" Grid.Column="1" Command="{Binding ToggleChatbotCommand}" 
                                        BackgroundColor="Transparent" TextColor="White" FontSize="18"/>
                            </Grid>
                        </Grid>
                        
                        <!-- Chat Messages -->
                        <ScrollView Grid.Row="1" Padding="8">
                            <CollectionView ItemsSource="{Binding ChatMessages}" VerticalOptions="Start">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatMessage">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- User Message (Right) -->
                                            <Frame Grid.Column="1" Padding="12,8" CornerRadius="16" 
                                                   BackgroundColor="{StaticResource Orange70Color}"
                                                   HorizontalOptions="End" 
                                                   IsVisible="{Binding IsFromUser}">
                                                <Label Text="{Binding Content}" TextColor="White" 
                                                       LineBreakMode="WordWrap" FontSize="14"/>
                                            </Frame>
                                            
                                            <!-- Bot Message (Left) -->
                                            <Frame Grid.Column="0" Padding="12,8" CornerRadius="16" 
                                                   BackgroundColor="#F0F0F0"
                                                   HorizontalOptions="Start" 
                                                   IsVisible="{Binding IsFromUser, Converter={StaticResource InverseBoolConverter}}">
                                                <Label Text="{Binding Content}" TextColor="Black" 
                                                       LineBreakMode="WordWrap" FontSize="14"/>
                                            </Frame>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                        
                        <!-- Input Area -->
                        <Grid Grid.Row="2" Padding="8" ColumnDefinitions="*,Auto">
                            <Entry Placeholder="Nhập tin nhắn..." Text="{Binding ChatbotInput}" 
                                   Grid.Column="0" Margin="0,0,8,0" ReturnCommand="{Binding SendChatbotCommand}"/>
                            <Button Text="Gửi" Grid.Column="1" Command="{Binding SendChatbotCommand}"
                                    BackgroundColor="{StaticResource Orange70Color}" TextColor="White"
                                    CornerRadius="8" Padding="16,8"/>
                        </Grid>
                    </Grid>
                </Frame>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>