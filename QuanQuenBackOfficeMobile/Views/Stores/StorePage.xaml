<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
    xmlns:models="clr-namespace:QuanQuenBackOfficeMobile.Models"
    xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
    x:Class="QuanQuenBackOfficeMobile.Views.StorePage"
    x:DataType="vm:StorePageViewModel">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullOrEmptyToNAConverter x:Key="NullOrEmptyToNAConverter" />
            <converters:AvatarUrlConverter x:Key="AvatarUrlConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="8" RowSpacing="8">
        <!-- Logo Section -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" Margin="0,10,0,20">
            <Image Source="logo_qq_new.png" HeightRequest="80" WidthRequest="80" />
        </VerticalStackLayout>

        <!-- Header -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label Text="Danh sách nhà hàng" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Grid.Column="0"/>
            <Button Text="➕ Tạo mới"
                    Command="{Binding CreateStoreCommand}"
                    Grid.Column="1"
                    FontSize="12"
                    BackgroundColor="{StaticResource Orange70Color}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="35"
                    CornerRadius="8"/>
        </Grid>

        <!-- Search Bar -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,0">
            <Border Stroke="{AppThemeBinding Light={StaticResource Orange70Color}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="0"
                    Margin="0,0,5,0"
                    HeightRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Entry Placeholder="Tìm kiếm cửa hàng..." 
                       Text="{Binding SearchText}"
                       FontSize="14"
                       Margin="10,0"
                       VerticalOptions="Center"
                       HeightRequest="40"
                       ReturnCommand="{Binding SearchCommand}"
                       ReturnType="Search"/>
            </Border>
            <Button Grid.Column="1"
                    Text="🔍" 
                    Command="{Binding SearchCommand}"
                    FontSize="18"
                    Padding="0"
                    HeightRequest="40"
                    WidthRequest="40"
                    CornerRadius="8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Orange70Color}, Dark={StaticResource Primary}}"
                    TextColor="White"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>
        </Grid>

        <!-- Store List -->
        <Grid Grid.Row="3">
            <CollectionView
                ItemsSource="{Binding Stores}"
                RemainingItemsThreshold="5"
                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached"
                Margin="0,10,0,0"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="Không có cửa hàng nào"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StoreModel">
                        <Frame Padding="0" Margin="0,0,0,10" CornerRadius="24" HasShadow="True" BackgroundColor="White" BorderColor="{StaticResource Orange70Color}">
                            <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto" Padding="18">
                                <!-- Avatar -->
                                <Frame Grid.Column="0" Padding="0" HeightRequest="80" WidthRequest="80" CornerRadius="40" HasShadow="False" BackgroundColor="#FFF3E0" VerticalOptions="Center">
                                    <Image Source="{Binding Avatar, Converter={StaticResource AvatarUrlConverter}}" HeightRequest="80" WidthRequest="80" Aspect="AspectFill"/>
                                </Frame>
                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="16,0,0,0" VerticalOptions="Center">
                                    <Label Text="{Binding StoreName}" FontSize="18" FontAttributes="Bold" TextColor="#222" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Address}" FontSize="14" TextColor="#666" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding StoreType, Converter={StaticResource NullOrEmptyToNAConverter}}" FontSize="13" TextColor="#009688"/>
                                    <Label Text="{Binding OpeningTime, StringFormat='Giờ mở cửa: {0}'} - {Binding ClosingTime, StringFormat='Đóng: {0}'}" FontSize="13" TextColor="#F58220"/>
                                </VerticalStackLayout>
                                <!-- Status + Action -->
                                <VerticalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center" HorizontalOptions="End">
                                    <Border BackgroundColor="{Binding IsOpen, Converter={x:Static converters:BoolToColorConverter.Instance}}"
                                            Padding="8,3" Margin="0,0,0,8" >
                                        <Label Text="{Binding IsOpen, Converter={x:Static converters:BoolToStatusConverter.Instance}}"
                                               FontSize="13" TextColor="White" FontAttributes="Bold"/>
                                    </Border>
                                    <Button Text="Chi tiết"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StorePageViewModel}}, Path=ViewDetailCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="14"
                                            Padding="10,4"
                                            BackgroundColor="{StaticResource Orange70Color}"
                                            TextColor="White"
                                            CornerRadius="10"
                                            HeightRequest="34"
                                            WidthRequest="80"
                                            HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Grid IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="True" 
                                         HorizontalOptions="Center" 
                                         VerticalOptions="Center" 
                                         Margin="0,10"/>
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>

            <!-- Loading Overlay -->
            <Grid IsVisible="{Binding IsLoading}" 
                  BackgroundColor="#80000000">
                <ActivityIndicator IsRunning="True" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center" 
                                 Color="White"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>