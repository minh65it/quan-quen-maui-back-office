<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.ScanningQRPage"
             xmlns:cv="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
             Title="QR Scanner">
    
    <VerticalStackLayout Spacing="20" Padding="20" VerticalOptions="Center">

        <Label FontSize="18" 
               HorizontalOptions="Center"
               Text="Hướng camera vào QR Code để quét" />
        
        <!-- Camera View -->
        <cv:CameraView x:Name="cameraView"
                       CamerasLoaded="cameraView_CamerasLoaded"
                       BarcodeDetected="CameraView_BarcodeDetected" 
                       BarCodeDetectionEnabled="True"
                       HeightRequest="400" />
        
        <!-- Camera Switch Button -->
        <Button x:Name="switchCameraButton"
                Text="🔄 Chuyển Camera"
                Clicked="SwitchCamera_Clicked"
                BackgroundColor="#007BFF"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="20"
                HeightRequest="40"
                WidthRequest="150"
                HorizontalOptions="Center"
                IsVisible="False" />
        
        <!-- Button cập nhật -->
        <Button x:Name="confirmUpdateButton"
                Text="Cập nhật thông tin nhà hàng vào QR"
                Clicked="ConfirmUpdate_Clicked"
                BackgroundColor="#28A745"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                IsVisible="False" />
        <Label x:Name="barcodeResult"
               HorizontalOptions="Center"
               FontSize="16"/>

    </VerticalStackLayout>
</ContentPage>