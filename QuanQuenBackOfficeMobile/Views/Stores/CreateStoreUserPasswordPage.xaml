<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.CreateStoreUserPasswordPage"
             x:DataType="viewmodels:CreateStoreUserPasswordViewModel"
             Title="">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start">
                <!-- Back Button -->
                <Grid>
                    <Button Command="{Binding BackCommand}"
                            ImageSource="icon_back.png"
                            BackgroundColor="White"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"/>
                </Grid>

                <!-- Logo -->
                <Image Source="logo_qq_new.png"
                       HeightRequest="120"
                       HorizontalOptions="Center"/>
                <!-- Email -->
                <Label Text="Email đăng nhập vào tài khoản nhà hàng*"
                       FontSize="16"
                       TextColor="Black"/>
                <Entry Placeholder="Email"
                       Text="{Binding Email}"
                       IsEnabled="False"
                       Keyboard="Email"
                       FontSize="16"
                       BackgroundColor="White"
                       HeightRequest="48"
                       Margin="0,0,0,10"/>

                <!-- Password -->
                <Label Text="Nhập mật khẩu *"
                       FontSize="16"
                       TextColor="Black"/>
                <Grid ColumnDefinitions="50,*,50">
                    <Image Grid.Column="0" Source="pw.png" HeightRequest="16"/>
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="1"
                           Placeholder="Mật khẩu"
                           IsPassword="{Binding IsPasswordHidden}"
                           Text="{Binding Password}"
                           FontSize="16"
                           BackgroundColor="White"
                           HeightRequest="48"
                           Margin="0,0,0,10" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding TogglePasswordVisibilityCommand}"
                        Text="{Binding PasswordEyeIcon}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Confirm Password -->
                <Grid ColumnDefinitions="50,*,50">
                    <Image Grid.Column="0" Source="pw.png" HeightRequest="16"/>
                    <Entry x:Name="ConfirmPasswordEntry"
                           Grid.Column="1"
                           Placeholder="Xác nhận mật khẩu của bạn"
                           IsPassword="{Binding IsConfirmPasswordHidden}"
                           Text="{Binding ConfirmPassword}"
                           FontSize="16"
                           BackgroundColor="White"
                           HeightRequest="48"
                           Margin="0,0,0,10"/>
                    <Button
                        Grid.Column="2"
                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                        Text="{Binding ConfirmPasswordEyeIcon}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Error Message -->
                <Label Text="{Binding PasswordError}"
                       FontSize="14"
                       TextColor="Red"
                       IsVisible="{Binding PasswordError, Converter={StaticResource StringToBoolConverter}}"
                       Margin="0,0,0,10"/>

                <!-- Accept Terms -->
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding IsAccepted}" Color="#FF9900"/>
                        <Label Text="Tôi đã đọc và chấp nhận"
                               FontSize="13"
                               TextColor="Black"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Spacing="4" Margin="28,0,0,0">
                        <Label Text="•" FontSize="13" TextColor="#FF9900"/>
                        <Label FontSize="13" TextColor="#FF9900">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Điều khoản dịch vụ" TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowTermsCommand}" />
                                        </Span.GestureRecognizers>
                                    </Span>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Spacing="4" Margin="28,0,0,0">
                        <Label Text="•" FontSize="13" TextColor="#FF9900"/>
                        <Label FontSize="13" TextColor="#FF9900">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Chính sách bảo mật" TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowPolicyCommand}" />
                                        </Span.GestureRecognizers>
                                    </Span>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                    
                    <Label Text="của Quán Quen"
                           FontSize="13"
                           TextColor="Black"
                           Margin="28,0,0,0"/>
                </VerticalStackLayout>

                <!-- Register Button -->
                <Button Text="Đăng ký"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#FF9900"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="25"
                        FontSize="18"
                        Margin="0,20,0,0"/>

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                 IsVisible="{Binding IsBusy}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>
        <!-- Overlay loading -->
        <BoxView IsVisible="{Binding IsLoading}" BackgroundColor="Black" Opacity="0.3" Grid.RowSpan="99" />
        <ActivityIndicator IsVisible="{Binding IsLoading}" IsRunning="{Binding IsLoading}"
                           Color="#FF9900" WidthRequest="60" HeightRequest="60"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>