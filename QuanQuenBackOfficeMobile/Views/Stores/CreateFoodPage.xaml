<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels.Stores"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.CreateFoodPage"
             x:DataType="viewmodels:CreateFoodViewModel"
             Title="Tạo món ăn mới"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#FF9800"
                             HeightRequest="50" />

            <!-- Form Card -->
            <Frame Padding="20"
                   CornerRadius="12"
                   BorderColor="#E0E0E0"
                   BackgroundColor="White"
                   HasShadow="True"
                   IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="16">
                    
                    <!-- Header -->
                    <Label Text="🍽️ Thông tin món ăn" 
                           FontAttributes="Bold" 
                           FontSize="20" 
                           TextColor="#FF9800" 
                           HorizontalOptions="Center" />

                    <!-- Filter Info -->
                    <Frame Padding="12"
                           BackgroundColor="#FFF3E0"
                           BorderColor="#FF9800"
                           CornerRadius="8"
                           HasShadow="False">
                        <Label Text="{Binding FilterName, StringFormat='Bộ lọc: {0}'}"
                               FontSize="14"
                               TextColor="#F57C00"
                               FontAttributes="Bold" />
                    </Frame>

                    <!-- Food Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tên món ăn *" 
                               FontSize="14" 
                               TextColor="#666" />
                        <Entry Text="{Binding FoodName, Mode=TwoWay}"
                               Placeholder="Ví dụ: Bún bò Huế, Phở bò..."
                               BackgroundColor="White"
                               TextColor="#333" />
                    </VerticalStackLayout>

                    <!-- Description -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mô tả" 
                               FontSize="14" 
                               TextColor="#666" />
                        <Editor Text="{Binding Description, Mode=TwoWay}"
                                Placeholder="Mô tả món ăn (không bắt buộc)"
                                BackgroundColor="White"
                                TextColor="#333"
                                HeightRequest="80" />
                    </VerticalStackLayout>

                    <!-- Price -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Giá *" 
                               FontSize="14" 
                               TextColor="#666" />
                        <Entry Text="{Binding Price, Mode=TwoWay}"
                               Placeholder="0"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               TextColor="#333" />
                    </VerticalStackLayout>

                    <!-- Price Sale -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Giá khuyến mãi" 
                               FontSize="14" 
                               TextColor="#666" />
                        <Entry Text="{Binding PriceSale, Mode=TwoWay}"
                               Placeholder="0 (Mặc định bằng giá gốc)"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               TextColor="#333" />
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                        <Button Grid.Column="0"
                                Text="✅ Tạo món"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="50"
                                FontSize="16"
                                FontAttributes="Bold"
                                Command="{Binding CreateFoodCommand}" />
                        
                        <Button Grid.Column="1"
                                Text="❌ Hủy"
                                BackgroundColor="#F44336"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="50"
                                FontSize="16"
                                FontAttributes="Bold"
                                Command="{Binding CancelCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

