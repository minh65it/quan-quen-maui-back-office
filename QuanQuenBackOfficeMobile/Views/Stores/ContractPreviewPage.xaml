<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels.Stores"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.ContractPreviewPage"
             x:DataType="viewmodels:ContractPreviewViewModel"
             Title="Xem trước hợp đồng">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Frame Grid.Row="0" 
               CornerRadius="0" 
               Padding="20" 
               BackgroundColor="#F5F5F5" 
               HasShadow="False">
            <Label Text="Xem trước hợp đồng (PDF.js)" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Frame>

        <!-- WebView để hiển thị HTML -->
        <WebView Grid.Row="1" 
                 x:Name="ContractWebView"
                 Source="{Binding HtmlSource}"
                 IsVisible="{Binding IsHtmlLoaded}"/>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>

        <!-- Error message -->
        <VerticalStackLayout Grid.Row="1" 
                            IsVisible="{Binding HasError}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="10">
            <Label Text="❌" 
                   FontSize="48" 
                   HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}" 
                   FontSize="16" 
                   TextColor="Red"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Text="Thử lại" 
                    Command="{Binding RetryCommand}"
                    BackgroundColor="#F58220"
                    TextColor="White"
                    HeightRequest="40"
                    CornerRadius="20"/>
        </VerticalStackLayout>

        <!-- Sign Contract Button - Overlay when HTML loaded -->
        <Button Grid.Row="1"
                x:Name="SignContractButton"
                Text="✍️ Ký Hợp Đồng"
                IsVisible="{Binding IsHtmlLoaded}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="25"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="20,0,20,30"
                Clicked="OnSignContractClicked"/>
    </Grid>
</ContentPage> 