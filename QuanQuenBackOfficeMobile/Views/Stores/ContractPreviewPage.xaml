<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels.Stores"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.ContractPreviewPage"
             x:DataType="viewmodels:ContractPreviewViewModel"
             Title="Xem trước hợp đồng">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header với nút Tiếp theo -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10" BackgroundColor="#F5F5F5">
            <Label Grid.Column="0" 
                   Text="Xem trước hợp đồng (PDF.js)" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center"/>

            <Button Grid.Column="1" 
                    Text="Tiếp theo" 
                    Command="{Binding NextCommand}"
                    BackgroundColor="#F58220"
                    TextColor="White"
                    Margin="5,0"
                    HeightRequest="35"
                    FontSize="14"
                    CornerRadius="5"/>
        </Grid>

        <!-- WebView để hiển thị HTML -->
        <WebView Grid.Row="1" 
                 x:Name="ContractWebView"
                 Source="{Binding HtmlSource}"
                 IsVisible="{Binding IsHtmlLoaded}"/>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}"
                          IsVisible="{Binding IsBusy}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>

        <!-- Error message -->
        <VerticalStackLayout Grid.Row="1" 
                            IsVisible="{Binding HasError}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="10">
            <Label Text="❌" 
                   FontSize="48" 
                   HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}" 
                   FontSize="16" 
                   TextColor="Red"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Button Text="Thử lại" 
                    Command="{Binding RetryCommand}"
                    BackgroundColor="#F58220"
                    TextColor="White"
                    HeightRequest="40"
                    CornerRadius="20"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage> 