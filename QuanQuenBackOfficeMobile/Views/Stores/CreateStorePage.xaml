<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:QuanQuenBackOfficeMobile.Views"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
             x:Class="QuanQuenBackOfficeMobile.Views.CreateStorePage"
             xmlns:models="clr-namespace:QuanQuenBackOfficeMobile.Models"
             x:DataType="viewmodels:CreateStoreViewModel"
             xmlns:controls="clr-namespace:QuanQuenBackOfficeMobile.Controls"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             Title="Đăng ký nhà hàng">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />

            <!-- Style nút upload ảnh -->
            <Style x:Key="UploadButtonStyle" TargetType="Button">
                <Setter Property="HeightRequest" Value="44"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BackgroundColor" Value="#FFF7EE"/>
                <Setter Property="TextColor" Value="#F58220"/>
                <Setter Property="BorderColor" Value="#F58220"/>
                <Setter Property="BorderWidth" Value="1"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="10">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="logo_qq_new.png" HeightRequest="80" WidthRequest="80" />
            </VerticalStackLayout>

            <!-- Tên Nhà hàng -->
            <Label Text="Tên Nhà hàng *" FontSize="14" TextColor="Black" />
            <Entry Placeholder="Tên Nhà hàng/Quán ăn"
                   Text="{Binding StoreName}"
                   HeightRequest="44" FontSize="16" BackgroundColor="White" />
            <Label Text="{Binding StoreNameError}" FontSize="12" TextColor="Red"
                   IsVisible="{Binding StoreNameError, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Người đại diện -->
            <Label Text="Người đại diện *" FontSize="14" TextColor="Black" />
            <Entry Placeholder="Nhập tên người đại diện"
                   Text="{Binding RepresentativeName}"
                   HeightRequest="44" FontSize="16" BackgroundColor="White" />
            <Label Text="{Binding RepresentativeNameError}" FontSize="12" TextColor="Red"
                   IsVisible="{Binding RepresentativeNameError, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Thành phố -->
            <Label Text="Thành phố" FontSize="14" TextColor="Black" />
            <controls:CustomDropdownPicker Title="Chọn Thành Phố ..."
                                           ItemsSource="{Binding ProvinceList}"
                                           ItemDisplayBinding="{Binding Name}"
                                           SelectedItem="{Binding SelectedProvince}"
                                           HeightRequest="44"
                                           FontSize="14"
                                           BackgroundColor="White" />

            <!-- Quận -->
            <Label Text="Quận" FontSize="14" TextColor="Black" />
            <controls:CustomDropdownPicker Title="Chọn Quận ..."
                                           ItemsSource="{Binding DistrictList}"
                                           ItemDisplayBinding="{Binding Name}"
                                           SelectedItem="{Binding SelectedDistrict}"
                                           HeightRequest="44"
                                           FontSize="14"
                                           BackgroundColor="White" />

            <!-- Phường -->
            <Label Text="Phường" FontSize="14" TextColor="Black" />
            <controls:CustomDropdownPicker Title="Chọn Phường ..."
                                           ItemsSource="{Binding WardList}"
                                           ItemDisplayBinding="{Binding Name}"
                                           SelectedItem="{Binding SelectedWard}"
                                           HeightRequest="44"
                                           FontSize="14"
                                           BackgroundColor="White" />

            <!-- Địa chỉ -->
            <Label Text="Địa Chỉ *" FontSize="14" TextColor="Black" />
            <Entry Placeholder="Địa chỉ kinh doanh" Text="{Binding Address}" HeightRequest="44" FontSize="16" BackgroundColor="White" />
            <Label Text="{Binding AddressError}" FontSize="12" TextColor="Red"
                   IsVisible="{Binding AddressError, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Số điện thoại -->
            <Label Text="Số điện thoại đăng ký *" FontSize="14" TextColor="Black" />
            <Entry Placeholder="Nhập số điện thoại" Text="{Binding PhoneNumber}" HeightRequest="44" FontSize="16" Keyboard="Telephone" BackgroundColor="White" />
            <Label Text="{Binding PhoneError}" FontSize="12" TextColor="Red"
                   IsVisible="{Binding PhoneError, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Email -->
            <Label Text="Email đăng ký *" FontSize="14" TextColor="Black" />
            <Entry Placeholder="Nhập email" Text="{Binding Email}" HeightRequest="44" FontSize="16" Keyboard="Email" BackgroundColor="White" />
            <Label Text="{Binding EmailError}" FontSize="12" TextColor="Red"
                   IsVisible="{Binding EmailError, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Loại hình kinh doanh -->
            <Label Text="Loại hình kinh doanh *" FontSize="14" TextColor="Black" />
            <controls:CustomDropdownPicker ItemsSource="{Binding BusinessTypeList}"
                                           Title="Chọn loại hình kinh doanh"
                                           SelectedItem="{Binding SelectedBusinessType}"
                                           HeightRequest="44"
                                           FontSize="14"
                                           BackgroundColor="White" />
            <Label Text="{Binding BusinessTypeError}" FontSize="12" TextColor="Red"
                   IsVisible="{Binding BusinessTypeError, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- ✅ Mặt trước CCCD -->
            <Label Text="CMND/CCCD - Mặt trước *" FontSize="14" TextColor="Black" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Chụp ảnh" Command="{Binding CaptureFrontIdImageCommand}" Style="{StaticResource UploadButtonStyle}" />
                <Button Text="Chọn ảnh" Command="{Binding PickFrontIdImageCommand}" Style="{StaticResource UploadButtonStyle}" />
            </HorizontalStackLayout>
            <Grid Margin="0,8,0,0" HeightRequest="120" WidthRequest="120">
                <Border StrokeThickness="1" Stroke="#D9D9D9" Background="White" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding FrontIdImage}" Aspect="AspectFill"/>
                        <Border Background="White" HeightRequest="24" WidthRequest="24"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                IsVisible="{Binding HasFrontIdImage}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Image Source="multiply.png" WidthRequest="18" HeightRequest="18">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveFrontIdImageCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ✅ Mặt sau CCCD -->
            <Label Text="CMND/CCCD - Mặt sau *" FontSize="14" TextColor="Black" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Chụp ảnh" Command="{Binding CaptureBackIdImageCommand}" Style="{StaticResource UploadButtonStyle}" />
                <Button Text="Chọn ảnh" Command="{Binding PickBackIdImageCommand}" Style="{StaticResource UploadButtonStyle}" />
            </HorizontalStackLayout>
            <Grid Margin="0,8,0,0" HeightRequest="120" WidthRequest="120">
                <Border StrokeThickness="1" Stroke="#D9D9D9" Background="White" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding BackIdImage}" Aspect="AspectFill"/>
                        <Border Background="White" HeightRequest="24" WidthRequest="24"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                IsVisible="{Binding HasBackIdImage}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Image Source="multiply.png" WidthRequest="18" HeightRequest="18">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveBackIdImageCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ✅ Giấy phép kinh doanh -->
            <Label Text="Giấy phép ĐKKD *" FontSize="14" TextColor="Black" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Chụp ảnh" Command="{Binding CaptureBusinessRegistrationImageCommand}" Style="{StaticResource UploadButtonStyle}" />
                <Button Text="Chọn ảnh" Command="{Binding PickBusinessRegistrationImageCommand}" Style="{StaticResource UploadButtonStyle}" />
            </HorizontalStackLayout>
            <Grid Margin="0,8,0,0" HeightRequest="120" WidthRequest="120">
                <Border StrokeThickness="1" Stroke="#D9D9D9" Background="White" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding BusinessRegistrationImage}" Aspect="AspectFill"/>
                        <Border Background="White" HeightRequest="24" WidthRequest="24"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                IsVisible="{Binding HasBusinessRegistrationImage}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Image Source="multiply.png" WidthRequest="18" HeightRequest="18">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveBusinessRegistrationImageCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Button Text="Tiếp theo"
                    Command="{Binding NextCommand}"
                    HeightRequest="50" FontSize="18" FontAttributes="Bold"
                    TextColor="White" CornerRadius="25" BackgroundColor="#F58220"
                    Margin="0,20,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
