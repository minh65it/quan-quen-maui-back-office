<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:QuanQuenBackOfficeMobile.Models"
             x:Class="QuanQuenBackOfficeMobile.Views.Stores.StoreDetailPage"
             Title="Chi Tiết Nhà Hàng">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding StoreDetail.StoreName}" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource Primary}"/>
            
            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="8"
                   Padding="12"
                   Margin="0,8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Thông tin liên hệ" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    
                    <Label Text="Số điện thoại:" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding StoreDetail.StorePhone}" />
                    
                    <Label Text="Email:" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding StoreDetail.StoreEmail}" />
                    
                    <Label Text="Địa chỉ:" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding StoreDetail.FullAdrress}" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="{StaticResource Gray200}"
                   CornerRadius="8"
                   Padding="12"
                   Margin="0,8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Thông tin cấp bậc" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Mã cấp bậc:" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding StoreDetail.LevelId}" />
                    
                    <Label Text="Trạng thái:" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="{Binding StoreDetail.Status, StringFormat='{0}'}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage> 