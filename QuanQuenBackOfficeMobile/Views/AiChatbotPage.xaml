<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanQuenBackOfficeMobile.Views.AiChatbotPage"
             Title="AI Chatbot">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Entry Placeholder="Nhập câu hỏi..." Text="{Binding InputMessage}" />
        <Button Text="Gửi" Command="{Binding SendCommand}" />
        <ScrollView>
            <Label Text="{Binding ResponseMessage}" LineBreakMode="WordWrap" />
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>


