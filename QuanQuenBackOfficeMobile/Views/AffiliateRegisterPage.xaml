<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
    xmlns:Controls="clr-namespace:QuanQuenBackOfficeMobile.Controls"
    xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
    x:Class="QuanQuenBackOfficeMobile.Views.AffiliateRegisterPage"
    x:DataType="viewmodels:AffiliateRegisterViewModel"
    Title="Đăng ký Affiliate"
    BackgroundColor="White">

    <ContentPage.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- Logo -->
            <Image
                Source="logo_qq_new.png"
                HeightRequest="80"
                HorizontalOptions="Center" />

            <!-- Title -->
            <Label
                Text="Đăng ký Affiliate"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333333"
                Margin="0,10,0,20"/>

            <!-- Full Name Entry -->
            <Frame
                HasShadow="False"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="0"
                BackgroundColor="#F8F9FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Source="user.png"
                        WidthRequest="20"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />

                    <Controls:NoUnderlineEntry
                        Grid.Column="1"
                        Placeholder="Họ và tên"
                        Text="{Binding FullName}"
                        BackgroundColor="Transparent"
                        HeightRequest="45"
                        VerticalOptions="Center"
                        Margin="0,0,15,0"/>
                </Grid>
            </Frame>
            <Label
                Text="Vui lòng nhập họ và tên"
                TextColor="Red"
                IsVisible="{Binding ShowEmptyFullNameError}"
                FontSize="Small"/>

            <!-- Phone Number Entry -->
            <Frame
                HasShadow="False"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="0"
                BackgroundColor="#F8F9FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Source="phone.png"
                        WidthRequest="20"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />

                    <Controls:NoUnderlineEntry
                        Grid.Column="1"
                        Placeholder="Số điện thoại"
                        Text="{Binding PhoneNumber}"
                        BackgroundColor="Transparent"
                        HeightRequest="45"
                        VerticalOptions="Center"
                        Margin="0,0,15,0"/>
                </Grid>
            </Frame>
            <Label
                Text="Vui lòng nhập số điện thoại"
                TextColor="Red"
                IsVisible="{Binding ShowEmptyPhoneError}"
                FontSize="Small"/>

            <!-- Email Entry -->
            <Frame
                HasShadow="False"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="0"
                BackgroundColor="#F8F9FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Source="email.png"
                        WidthRequest="20"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />

                    <Controls:NoUnderlineEntry
                        Grid.Column="1"
                        Placeholder="Email"
                        Text="{Binding Email}"
                        BackgroundColor="Transparent"
                        HeightRequest="45"
                        VerticalOptions="Center"
                        Margin="0,0,15,0"/>
                </Grid>
            </Frame>
            <Label
                Text="Vui lòng nhập email"
                TextColor="Red"
                IsVisible="{Binding ShowEmptyEmailError}"
                FontSize="Small"/>

            <!-- Address Entry -->
            <Frame
                HasShadow="False"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="0"
                BackgroundColor="#F8F9FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Source="location.png"
                        WidthRequest="20"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />

                    <Controls:NoUnderlineEntry
                        Grid.Column="1"
                        Placeholder="Địa chỉ"
                        Text="{Binding Address}"
                        BackgroundColor="Transparent"
                        HeightRequest="45"
                        VerticalOptions="Center"
                        Margin="0,0,15,0"/>
                </Grid>
            </Frame>
            <Label
                Text="Vui lòng nhập địa chỉ"
                TextColor="Red"
                IsVisible="{Binding ShowEmptyAddressError}"
                FontSize="Small"/>

            <!-- Referrer Type Selection -->
            <Frame
                HasShadow="False"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="15"
                BackgroundColor="#F8F9FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton
                        Grid.Column="0"
                        Content="Cá Nhân"
                        IsChecked="{Binding SelectedReferrerType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Personal}"
                        GroupName="ReferrerType"
                        Margin="0,0,10,0"/>

                    <RadioButton
                        Grid.Column="1"
                        Content="Công Ty"
                        IsChecked="{Binding SelectedReferrerType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Company}"
                        GroupName="ReferrerType"
                        Margin="10,0,0,0"/>
                </Grid>
            </Frame>

            <!-- Password Entry -->
            <Frame
                HasShadow="False"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="0"
                BackgroundColor="#F8F9FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Source="pw.png"
                        WidthRequest="20"
                        HeightRequest="20"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />

                    <Controls:NoUnderlineEntry
                        Grid.Column="1"
                        Placeholder="Mật khẩu"
                        Text="{Binding Password}"
                        IsPassword="{Binding IsPasswordHidden}"
                        BackgroundColor="Transparent"
                        HeightRequest="45"
                        VerticalOptions="Center"
                        Margin="0,0,15,0"/>

                    <Button
                        Grid.Column="2"
                        Command="{Binding TogglePasswordVisibilityCommand}"
                        Text="{Binding PasswordVisibilityIcon}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Grid>
            </Frame>
            <Label
                Text="Vui lòng nhập mật khẩu"
                TextColor="Red"
                IsVisible="{Binding ShowEmptyPasswordError}"
                FontSize="Small"/>
            <Label
                Text="Mật khẩu cần ít nhất 6 ký tự"
                TextColor="Red"
                IsVisible="{Binding ShowLengthPasswordError}"
                FontSize="Small"/>


            <!-- Error Message -->
            <Label
                Text="{Binding AuthError}"
                TextColor="Red"
                FontSize="Small"
                IsVisible="{Binding ShowAuthError}"
                Margin="10,0,0,0"/>

            <!-- Register Button -->
            <Button
                Text="Đăng ký"
                TextColor="White"
                HeightRequest="50"
                CornerRadius="25"
                Command="{Binding RegisterCommand}"
                Margin="0,10,0,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4CAF50" Offset="0.0" />
                        <GradientStop Color="#2E7D32" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- Back to Affiliate Login -->
            <Button
                Text="Quay lại đăng nhập"
                TextColor="#666666"
                BackgroundColor="Transparent"
                HeightRequest="40"
                Command="{Binding BackToAffiliateLoginCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
