<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:QuanQuenBackOfficeMobile.ViewModels"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.AffiliateStoreUserPasswordPage"
             x:DataType="viewmodels:AffiliateStoreUserPasswordViewModel"
             Title="Tạo tài khoản Store">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start">
                <!-- Back Button -->
                <Grid>
                    <Button Command="{Binding BackCommand}"
                            ImageSource="icon_back.png"
                            BackgroundColor="White"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"/>
                </Grid>

                <!-- Logo -->
                <Image Source="logo_qq_new.png"
                       HeightRequest="120"
                       HorizontalOptions="Center"/>
                
                <!-- Title -->
                <Label Text="Tạo tài khoản Store Affiliate"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#333333"
                       Margin="0,10,0,20"/>

                <!-- Email -->
                <Label Text="Email đăng nhập vào tài khoản nhà hàng*"
                       FontSize="16"
                       TextColor="Black"/>
                <Entry Placeholder="Email"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       FontSize="16"
                       BackgroundColor="White"
                       HeightRequest="48"
                       Margin="0,0,0,10"/>

                <!-- Password -->
                <Label Text="Nhập mật khẩu *"
                       FontSize="16"
                       TextColor="Black"/>
                <Grid ColumnDefinitions="50,*,50">
                    <Image Grid.Column="0" Source="pw.png" HeightRequest="16"/>
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="1"
                           Placeholder="Mật khẩu"
                           IsPassword="{Binding IsPasswordHidden}"
                           Text="{Binding Password}"
                           FontSize="16"
                           BackgroundColor="White"
                           HeightRequest="48"
                           Margin="0,0,0,10" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding TogglePasswordVisibilityCommand}"
                        Text="{Binding PasswordEyeIcon}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Confirm Password -->
                <Grid ColumnDefinitions="50,*,50">
                    <Image Grid.Column="0" Source="pw.png" HeightRequest="16"/>
                    <Entry x:Name="ConfirmPasswordEntry"
                           Grid.Column="1"
                           Placeholder="Xác nhận mật khẩu của bạn"
                           IsPassword="{Binding IsConfirmPasswordHidden}"
                           Text="{Binding ConfirmPassword}"
                           FontSize="16"
                           BackgroundColor="White"
                           HeightRequest="48"
                           Margin="0,0,0,10"/>
                    <Button
                        Grid.Column="2"
                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                        Text="{Binding ConfirmPasswordEyeIcon}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Error Message -->
                <Label Text="{Binding PasswordError}"
                       FontSize="14"
                       TextColor="Red"
                       IsVisible="{Binding PasswordError, Converter={StaticResource StringToBoolConverter}}"
                       Margin="0,0,0,10"/>

                <!-- Create Account Button -->
                <Button Text="Tạo tài khoản"
                        Command="{Binding CreateAccountCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        HeightRequest="50"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        CornerRadius="25"
                        BackgroundColor="#4CAF50"
                        Margin="0,20,0,0"/>

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                 IsVisible="{Binding IsBusy}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
