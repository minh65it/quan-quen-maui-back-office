<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuanQuenBackOfficeMobile.ViewModels.Affiliates"
             xmlns:models="clr-namespace:QuanQuenBackOfficeMobile.Models"
             xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
             x:Class="QuanQuenBackOfficeMobile.Views.Affiliates.AffiliatePhotoPage"
             x:DataType="vm:AffiliatePhotoViewModel"
             BackgroundColor="#F5F5F5"
             x:Name="RootPage"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="10">
            <!-- Logo và tên ứng dụng -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="logo_qq_new.png" HeightRequest="80" WidthRequest="80" />
            </VerticalStackLayout>

            <!-- Tiêu đề -->
            <Label Text="Thêm hình ảnh nhà hàng (Affiliate)"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <!-- Khu 1: Ảnh Nhà hàng (3 ảnh: 1 tổng quan, 2 không gian) -->
            <Label Text="Ảnh Nhà hàng (tối đa 3 ảnh: 1 tổng quan, 2 không gian)"
                   FontSize="14"
                   TextColor="Black" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Chụp ảnh nhà hàng"
                        Clicked="OnCaptureRestaurantPhotoClicked"
                        IsEnabled="{Binding CanAddMoreRestaurantImages}"
                        HeightRequest="44"
                        FontSize="16"
                        BackgroundColor="#F5F5F5"
                        TextColor="{Binding ButtonTextColor}"
                        BorderColor="#F58220"
                        CornerRadius="12"/>
                <Button Text="Chọn ảnh nhà hàng"
                        Clicked="OnPickRestaurantPhotoClicked"
                        IsEnabled="{Binding CanAddMoreRestaurantImages}"
                        HeightRequest="44"
                        FontSize="16"
                        BackgroundColor="#F5F5F5"
                        TextColor="{Binding ButtonTextColor}"
                        BorderColor="#F58220"
                        CornerRadius="12"/>
            </HorizontalStackLayout>
            <CollectionView x:Name="PhotoCollectionView"
                ItemsSource="{Binding RestaurantImages}"
                HeightRequest="200"
                Margin="0,5,0,0"
                >
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MyImageModel">
                        <Border HeightRequest="80" WidthRequest="80"
                    Stroke="#E0E0E0" StrokeThickness="1"
                    Background="White"
                    Margin="2" Padding="0"
                    HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Image Source="{Binding Images}" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" Margin="0"/>
                                <Border Padding="0" HeightRequest="20" WidthRequest="20" Background="White" Stroke="White" StrokeThickness="1"
                            HorizontalOptions="End" VerticalOptions="Start" Margin="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Image Source="multiply.png"
                               WidthRequest="16" HeightRequest="16"
                               HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                    Command="{Binding BindingContext.RemoveImageCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                    CommandParameter="{Binding Images}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ContentView WidthRequest="15"/>
                </CollectionView.Footer>
            </CollectionView>

            <!-- Khu 2: CCCD 2 mặt -->
            <Label Text="CCCD chủ/quản lý (2 mặt)" FontSize="14" TextColor="Black" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Button Text="Chọn CCCD mặt trước" Clicked="OnPickIdentityFrontClicked" />
                    <Image Source="{Binding IdentityFront.Images}" HeightRequest="120" Aspect="AspectFill" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Button Text="Chọn CCCD mặt sau" Clicked="OnPickIdentityBackClicked" />
                    <Image Source="{Binding IdentityBack.Images}" HeightRequest="120" Aspect="AspectFill" />
                </VerticalStackLayout>
            </Grid>

            <!-- Khu 3: Ảnh Menu -->
            <Label Text="Ảnh Menu" FontSize="14" TextColor="Black" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Chọn ảnh menu" Clicked="OnPickMenuPhotoClicked" IsEnabled="{Binding CanAddMoreMenuImages}" />
            </HorizontalStackLayout>
            <Image Source="{Binding MenuImages[0].Images}" HeightRequest="120" Aspect="AspectFill" Margin="0,5,0,0" />

            <!-- Nút Lưu và Bỏ qua -->
            <Grid Margin="0,30,0,0" RowDefinitions="Auto" ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Grid.Column="0"
                        Text="Bỏ qua"
                        Command="{Binding SkipCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        HeightRequest="55"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#F58220"
                        CornerRadius="28"
                        BackgroundColor="White"
                        BorderColor="#F58220"
                        BorderWidth="2"
                        Margin="0,0,7,0"/>
                <Button Grid.Column="1"
                        Text="Lưu ảnh"
                        Command="{Binding SavePhotoCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        HeightRequest="55"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        CornerRadius="28"
                        BackgroundColor="#F58220"
                        Margin="7,0,0,0"/>
            </Grid>

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


