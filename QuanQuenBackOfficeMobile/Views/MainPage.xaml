<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QuanQuenBackOfficeMobile.Views"
    x:Class="QuanQuenBackOfficeMobile.Views.MainPage"
    FlyoutBehavior="Flyout">

    <!-- Sidebar Header: Logo + User Info -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#393E43" Padding="20,40,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Logo and User Info -->
            <Image Source="logo_qq_new.png" 
                   HeightRequest="60" 
                   WidthRequest="60" 
                   VerticalOptions="Center" />
            <StackLayout Grid.Column="1" 
                        VerticalOptions="Center" 
                        Padding="10,0,0,0">
                <Label Text="admin" 
                       TextColor="White" 
                       FontSize="18" 
                       FontAttributes="Bold" />
                <Label Text="Quán Quen" 
                       TextColor="White" 
                       FontSize="14" />
            </StackLayout>

            <!-- Logout Button -->
            <Button Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Text="Đăng xuất"
                    Command="{Binding LogoutCommand}"
                    Margin="0,15,0,0"
                    HeightRequest="40"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HorizontalOptions="Fill"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Sidebar Menu -->
    <FlyoutItem Title="Danh sách nhà hàng" >
        <ShellContent ContentTemplate="{DataTemplate views:StorePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Về Quán Quen Agent">
        <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Test">
        <ShellContent ContentTemplate="{DataTemplate views:DrawingExamplePage}" />
    </FlyoutItem>
     <!--<FlyoutItem Title="Test1">
        <ShellContent ContentTemplate="{DataTemplate views:PhotoStoreUser}" />
    </FlyoutItem>
   <FlyoutItem Title="Test2">
        <ShellContent ContentTemplate="{DataTemplate views:Stores.StoreLevelPage}" />
    </FlyoutItem>-->
</Shell>
