<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:local="clr-namespace:QuanQuenBackOfficeMobile"
			 xmlns:converters="clr-namespace:QuanQuenBackOfficeMobile.Converters"
			 x:Class="QuanQuenBackOfficeMobile.App">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Styles/Colors.xaml" />
				<ResourceDictionary Source="Resources/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:InverseBoolConverter x:Key="InverseBoolConverter" />
			<converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
			<converters:GreaterThanOneConverter x:Key="GreaterThanOneConverter"/>
			<converters:LessThanTotalPagesConverter x:Key="LessThanTotalPagesConverter"/>
		</ResourceDictionary>
	</Application.Resources>
</Application>
